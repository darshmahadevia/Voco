{
  "name": "voco",
  "version": "0.2.1",
  "private": true,
  "description": "Local dictation for macOS",
  "author": "Voco contributors",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run build:native && env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "dev:ui": "vite --config vite.preview.config.ts --host 127.0.0.1",
    "build:icons": "bash scripts/build-icons.sh",
    "build:native": "bash scripts/build-native.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:renderer": "npm run verify:compact-ui",
    "build": "npm run typecheck && npm run build:icons && npm run build:native && electron-vite build",
    "pack": "npm run build && node scripts/package-desktop.mjs",
    "dist": "npm run build && node scripts/package-desktop.mjs dmg",
    "verify": "npm run typecheck && npm test && npm run build && npm run verify:renderer && npm run verify:motion",
    "verify:compact-ui": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-compact-ui.cjs",
    "verify:menu-bar": "node scripts/verify-menu-bar.mjs",
    "verify:insertion": "bash scripts/verify-buffered-insertion.sh",
    "verify:motion": "env -u ELECTRON_RUN_AS_NODE electron scripts/verify-motion.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  },
  "build": {
    "appId": "org.vocoapp.Voco",
    "productName": "Voco",
    "afterPack": "scripts/prepare-bundle.cjs",
    "afterSign": "scripts/prepare-bundle.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "Resources/Brand",
        "to": "brand"
      },
      {
        "from": "native/build/VocoNative.app",
        "to": "native/VocoNative.app"
      },
      {
        "from": "Resources/licenses",
        "to": "licenses"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "entitlements": "Resources/entitlements.mac.plist",
      "entitlementsInherit": "Resources/entitlements.mac.plist",
      "icon": "Resources/Voco.icns",
      "minimumSystemVersion": "26.0.0",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voco uses your microphone to transcribe speech on your Mac."
      }
    },
    "dmg": {
      "title": "Voco"
    }
  }
}
