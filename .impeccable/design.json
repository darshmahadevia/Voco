  "narrative": {
    "northStar": "Quiet Voice Workspace",
    "overview": "Dark minimal: graphite surfaces, soft white buttons, restrained orange details. Voco feels calm and personal, with a clear place to speak and small, readable signs of readiness. Bundled Manrope supplies every text role. Tonal surfaces draw inspiration from vibrant.design, and compact motion patterns are adapted from transitions.dev for the desktop workflow.",
    "keyCharacteristics": [
      "Tonal graphite layers",
      "Fully rounded soft-white primary controls",
      "Restrained orange voice feedback",
      "Flat statistics and divided transcript rows"
    ],
    "rules": [
      {
        "name": "Measured voice feedback",
        "body": "Animate waveform bars only from measured microphone energy. Silence has a still baseline.",
        "section": "components"
      },
      {
        "name": "Tonal depth",
        "body": "Use graphite layering for structural depth; reserve shadows for status capsules.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do retain visible keyboard focus and reduced-motion behavior.",
      "Do keep setup actions reachable while task content scrolls.",
      "Do preserve optional session transcripts in memory until quit."
    ],
    "donts": [
      "Don't reintroduce pixel or serif accent fonts or orange primary buttons.",
      "Don't synthesize microphone activity or show partial transcript text during capture.",
      "Don't persist audio or transcript history."
    ]
